JOBSUB

#!/bin/sh
#SBATCH -N 1
#SBATCH -t 240:00:00
#SBATCH --ntasks-per-node=32
#SBATCH --partition=tc


echo "== Starting run at $(date)"
echo "== Job ID: ${SLURM_JOBID}"
echo "== Node list: ${SLURM_NODELIST}"
echo "== Submit dir. : ${SLURM_SUBMIT_DIR}"
echo "== Scratch dir. : ${TMPDIR}"

module load ams/2025.103
module list

JOBSUB END

PyFrag

coordfile $SLURM_SUBMIT_DIR/n508.xyz
fragment  2
fragment  1 3 4
strain    291.96
strain    -451.06
bondlength 2 1 0

overlap frag1 HOMO frag2 HOMO
overlap frag1 HOMO frag2 LUMO
overlap frag1 LUMO frag2 HOMO-2
overlap A frag1 1 A frag2 5

orbitalenergy frag1 HOMO
orbitalenergy frag1 LUMO
orbitalenergy frag2 HOMO
orbitalenergy frag2 LUMO

PyFrag END

fragment1 EXTRA
System
  Charge 1
End

fragment1 EXTRA END

fragment2 EXTRA
System
  Charge 0
End
fragment2 EXTRA END

complex EXTRA
System
  Charge 1
End
complex EXTRA END

AMS

Task SinglePoint

Engine adf
  basis
    core none
    type TZ2P
  End


BECKEGRID
   Quality normal
End
STOFIT

Print Elstat

  EPRINT
    SFO Eig Ovl
  END
  xc
    GGA BP86
  End
EndEngine

AMS END
